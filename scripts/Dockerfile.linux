# GTK/WebKit build host for cloud workspaces without sudo.
FROM debian:trixie-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0
COPY setup-linux.sh /tmp/setup-linux.sh
RUN bash /tmp/setup-linux.sh && apt-get install -y --no-install-recommends \
    xvfb xauth dbus-x11 xdotool python3-pyatspi at-spi2-core fonts-noto-cjk \
    file git zip && rm -rf /var/lib/apt/lists/*
